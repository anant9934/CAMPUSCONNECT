# ==============================================================================
# CampusConnect — LPU AI Campus Assistant Environment Configuration (Example)
# ==============================================================================

# Database Configuration (PostgreSQL Neon Serverless / SQLite Local)
# Local SQLite default:
DATABASE_URL=sqlite+aiosqlite:///./campusconnect.db
# Neon Serverless PostgreSQL (Pooled runtime connection for Vercel):
# DATABASE_URL=postgresql://neondb_owner:<password>@ep-damp-cherry-be36t71y-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require
# Neon Direct Connection (for Alembic DDL migrations):
# DATABASE_DIRECT_URL=postgresql://neondb_owner:<password>@ep-damp-cherry-be36t71y.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require

# Redis Cloud Configuration
REDIS_API_ACCOUNT_KEY=your_redis_cloud_api_account_key

# Primary AI Provider: Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_SECONDARY=your_secondary_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2

# Multi-Provider LLM Gateway Settings
DEFAULT_LLM_PROVIDER=gemini
ROUTER_SELECTION_STRATEGY=adaptive

# OpenRouter Provider
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=inclusionai/ling-3.2-flash:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Groq High-Speed Inference Provider
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# BazaarLink AI Provider
BAZAARLINK_API_KEY=your_bazaarlink_api_key
BAZAARLINK_MODEL=qwen/qwen3.7-flash:free
BAZAARLINK_BASE_URL=https://api.bazaarlink.ai/v1

# Pekpik LLM Provider
PEKPIK_DEEPSEEK_API_KEY=your_pekpik_deepseek_token
PEKPIK_GPT_API_KEY=your_pekpik_gpt_token
PEKPIK_MODEL=deepseek-v4-1-flash-1017
PEKPIK_BASE_URL=https://aiapiv2.pekpik.com/v1

# Aion Labs Provider
AIONLABS_API_KEY=your_aionlabs_key
AIONLABS_BASE_URL=https://api.aionlabs.ai/v1

# Cohere Provider
COHERE_API_KEY=your_cohere_key
COHERE_MODEL=command-a-03-2025
COHERE_BASE_URL=https://api.cohere.com/v2

# Hugging Face Configuration
HF_TOKEN=your_hf_inference_token
HF_TOKEN_READ=your_hf_read_token
HF_TOKEN_WRITE=your_hf_write_token
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HF_EMBEDDING_DIMENSION=384

# Live Web Research
WEB_RESEARCH_ENABLED=true
WEB_RESEARCH_MAX_RESULTS=3

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Security
JWT_SECRET_KEY=dev_secret_key_campusconnect_lpu_2026_super_secure_auth_token_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_EMAIL=admin@lpu.co.in
ADMIN_DEFAULT_PASSWORD=CampusAdmin@2026

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
MAX_REQUESTS_PER_MINUTE_PER_SESSION=20
MAX_DAILY_QUOTA_REQUESTS=1500

# Voice AI (Audio Transcription & Speech Synthesis)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Career & Student Opportunities API
STARTUP_JOBS_API_KEY=your_startup_jobs_api_key_here

# Geo & Location Intelligence (Campus & Local Phagwara/Jalandhar)
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Web Scraping & Crawling
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
UPSCRAPE_API_KEY=your_upscrape_api_key_here

# Neural Search & Reranking (Jina AI)
JINA_API_KEY=your_jina_api_key_here

# Live Web Intelligence & Research (Tavily & NewsAPI)
TAVILY_API_KEY=your_tavily_api_key_here
NEWS_API_KEY=your_news_api_key_here

# Weather API (Open-Meteo - No Key Required)
LPU_LATITUDE=31.2460
LPU_LONGITUDE=75.7047
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
